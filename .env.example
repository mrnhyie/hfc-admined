# Postgres connection (Vercel Postgres / Neon pooled connection string)
DATABASE_URL=postgres://user:password@ep-x-y-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Random string used to sign admin session cookies (min 16 chars)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
SITE_TIMEZONE=Africa/Accra
SITE_NAME=Highlife Family Chapel International

# Admin portal login. Change the password here, then run `npm run admin:create`
# (or the same command against the production URL) to apply it.
ADMIN_EMAIL=you@church.org
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Church Admin
